# MongoDB Atlas connection string (required for saving & managing transcription history)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=sst_transcriptions

# Faster-Whisper WebSocket / HTTP backend URL (Hugging Face Space or local FastAPI server)
# Example HF Space: https://<hf-user>-sst-faster-whisper.hf.space
NEXT_PUBLIC_WHISPER_SERVER_URL=http://localhost:7860

# Optional: Hugging Face token for optional server-side HF Inference API fallback (/api/transcribe/hf)
HF_TOKEN=
